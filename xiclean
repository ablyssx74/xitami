#! /bin/sh
#
#  xiclean - remove files generated by xibuild, for a clean rebuild
#
#  xibuild's own build scripts (src/sfl/build, src/gsl/build, src/smt/build)
#  have no dependency tracking and no "clean" target of their own - a failed
#  or partial build can leave stale .o files, copied-in headers/libraries,
#  or a partially-updated lib*.a lying around.  This script removes anything
#  xibuild generates or copies into place, so the next ./xibuild run starts
#  from source only.  It does not touch anything xibuild itself doesn't
#  create (own tooling, configuration, or the SFL/SMT/GSL/CGI source files).
#
#  Usage: ./xiclean          - remove build artifacts (objects, libraries,
#                               binaries, copied-in headers)
#         ./xiclean runtime  - also remove runtime files from a test run
#                               (logs/console.log, logs/xitami.log,
#                               memtrace.lst) - NOT part of the build, just
#                               convenient when starting a fresh test.

TOPDIR=$PWD
SFLDIR=$TOPDIR/src/sfl
SMTDIR=$TOPDIR/src/smt
GSLDIR=$TOPDIR/src/gsl
CGISRC=$TOPDIR/cgi-src

echo "xiclean: removing object files and libraries..."
rm -f $SFLDIR/*.o $SFLDIR/lib*.a
rm -f $SMTDIR/*.o $SMTDIR/lib*.a
rm -f $GSLDIR/*.o $GSLDIR/lib*.a
rm -f $CGISRC/*.o $CGISRC/lib*.a

echo "xiclean: removing headers/libraries/tools copied in by xibuild..."
rm -f $GSLDIR/sfl.h
rm -f $SMTDIR/sfl.h $SMTDIR/ggcode.h
rm -f $CGISRC/sfl.h $CGISRC/c

echo "xiclean: removing built binaries..."
rm -f $TOPDIR/xitami $TOPDIR/gslgen
rm -f $CGISRC/testcgi $CGISRC/testcgi?
rm -f $TOPDIR/cgi-bin/testcgi $TOPDIR/cgi-bin/testcgi?

if [ "$1" = "runtime" ]; then
    echo "xiclean: removing runtime files from test runs..."
    rm -f $TOPDIR/logs/console.log $TOPDIR/logs/xitami.log
    rm -f $TOPDIR/memtrace.lst
fi

echo "xiclean: done - run ./xibuild for a clean rebuild."
